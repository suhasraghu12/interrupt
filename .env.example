# LiveKit (defaults match `livekit-server --dev`)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Turn-taking: baseline (ours, naive) | smart_turn (Pipecat's model) | semantic (ours)
TURN_TAKING_MODE=baseline
BASELINE_SILENCE_MS=700

# Providers: local-first defaults, no API keys required
STT_PROVIDER=faster_whisper
LLM_PROVIDER=local
TTS_PROVIDER=piper

WHISPER_MODEL=small.en
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434/v1
PIPER_VOICE=en_US-lessac-medium
